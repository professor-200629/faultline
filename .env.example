# Copy to .env (gitignored) or set as environment variables. Never commit real keys.
# Preferred on Windows: run scripts\set-nebius-key.ps1, which stores the key as a per-user variable.
NEBIUS_API_KEY=

# Optional overrides (defaults shown)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
FAULTLINE_MODEL=nvidia/nemotron-3-super-120b-a12b
# USD per 1M tokens for the chosen model (defaults: official public catalog, read 2026-10-26)
FAULTLINE_PRICE_IN_PER_M=0.30
FAULTLINE_PRICE_OUT_PER_M=0.90
# Hard ceiling on estimated model spend recorded by this installation (USD)
FAULTLINE_MAX_SPEND_USD=3.00
# Per-investigation budgets
FAULTLINE_MAX_TOOL_CALLS=12
FAULTLINE_MAX_MODEL_CALLS=16
FAULTLINE_WALL_CLOCK_S=120
FAULTLINE_REQUEST_TIMEOUT_S=60
FAULTLINE_MAX_RETRIES=2
FAULTLINE_MAX_OUTPUT_TOKENS=4096
# "default" leaves Nemotron reasoning as served; "off" sends chat_template_kwargs.enable_thinking=false
FAULTLINE_REASONING=default
